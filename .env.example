# Copy to .env and adjust as needed. The app reads these from the environment.

# Postgres connection. Dev default matches docker-compose.yml.
DATABASE_URL=postgresql://demucs:demucs@localhost:5432/demucs

# Flask bind. Use 0.0.0.0 inside a container; 127.0.0.1 natively.
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=1
