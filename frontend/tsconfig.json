{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "useDefineForClassFields": true,
    "resolveJsonModule": true,
    "isolatedModules": true,

    // The migration is complete: all source + tests are .ts/.tsx and type-checked
    // under `strict`. `allowJs` stays only for the one generated file
    // (src/lib/fluidParams.js, produced by `make gen-params`); `checkJs:false`
    // leaves that generated JS unchecked.
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["src"]
}
